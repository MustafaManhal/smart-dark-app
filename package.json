{
  "name": "reader343",
  "version": "1.0.0",
  "scripts": {
    "test": "node --test test/unit/*.test.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs --zip",
    "assets": "node scripts/make-icons.mjs && node scripts/make-sample-pdf.mjs",
    "e2e": "node scripts/build.mjs --e2e && node test/e2e/e2e.mjs",
    "e2e:firefox": "node scripts/build.mjs --e2e && node test/e2e/firefox.mjs",
    "store-assets": "node scripts/build.mjs --e2e && node scripts/store-assets.mjs && npm run app:build && node scripts/store-shots-app.mjs",
    "app:assets": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-tts-assets.mjs && node scripts/copy-ocr-assets.mjs",
    "app:dev": "npm run app:assets && vite",
    "app:build": "npm run app:assets && tsc -p tsconfig.json && vite build",
    "app:test": "vitest run",
    "app:e2e": "playwright test",
    "ios:sync": "npm run app:build && node scripts/ios-prepare.mjs && cap sync ios",
    "desktop": "npm run app:build && electron .",
    "desktop:e2e": "npm run app:build && playwright test --config playwright.desktop.config.ts",
    "desktop:mac": "npm run app:build && electron-builder --mac --publish never",
    "desktop:win": "npm run app:build && electron-builder --win --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@playwright/test": "1.63",
    "@preact/preset-vite": "^2.10.6",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "pdfjs-dist": "^6.3.289",
    "puppeteer-core": "^25.12.0",
    "tesseract.js": "^7.0.0",
    "ts-fsrs": "^5.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "fflate": "^0.8.3",
    "preact": "^10.29.8"
  },
  "main": "desktop/main.mjs",
  "description": "Reader343: a PDF reader with a dark mode that keeps colors",
  "author": {
    "name": "Mustafa Manhal"
  },
  "desktop": {
    "updateRepo": "MustafaManhal/smart-dark-app"
  }
}
