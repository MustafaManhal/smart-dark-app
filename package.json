{
  "name": "smart-dark-pdf",
  "version": "1.0.0",
  "scripts": {
    "test": "node --test test/unit/*.test.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs --zip",
    "assets": "node scripts/make-icons.mjs && node scripts/make-sample-pdf.mjs",
    "e2e": "node scripts/build.mjs --e2e && node test/e2e/e2e.mjs",
    "store-assets": "node scripts/build.mjs --e2e && node scripts/store-assets.mjs",
    "app:assets": "node scripts/copy-pdfjs-assets.mjs",
    "app:dev": "npm run app:assets && vite",
    "app:build": "npm run app:assets && tsc -p tsconfig.json && vite build",
    "app:test": "vitest run",
    "app:e2e": "playwright test",
    "desktop": "npm run app:build && electron .",
    "desktop:e2e": "npm run app:build && playwright test --config playwright.desktop.config.ts",
    "desktop:mac": "npm run app:build && electron-builder --mac --publish never",
    "desktop:win": "npm run app:build && electron-builder --win --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.63",
    "@preact/preset-vite": "^2.10.6",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "pdfjs-dist": "^6.3.289",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "fflate": "^0.8.3",
    "preact": "^10.29.8"
  },
  "main": "desktop/main.mjs",
  "description": "Smart Dark Reader: a PDF reader with a dark mode that keeps colors",
  "author": {
    "name": "Mustafa Manhal"
  },
  "desktop": {
    "updateRepo": ""
  }
}
