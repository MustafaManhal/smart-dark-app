{
  "name": "smart-dark-pdf",
  "version": "1.0.0",
  "scripts": {
    "test": "node --test test/unit/*.test.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs --zip",
    "assets": "node scripts/make-icons.mjs && node scripts/make-sample-pdf.mjs",
    "e2e": "node scripts/build.mjs --e2e && node test/e2e/e2e.mjs",
    "store-assets": "node scripts/build.mjs --e2e && node scripts/store-assets.mjs",
    "app:assets": "node scripts/copy-pdfjs-assets.mjs",
    "app:dev": "npm run app:assets && vite",
    "app:build": "npm run app:assets && tsc -p tsconfig.json && vite build",
    "app:test": "vitest run",
    "app:e2e": "playwright test"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.63",
    "@preact/preset-vite": "^2.10.6",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "pdfjs-dist": "^6.3.289",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^10.29.8"
  }
}
